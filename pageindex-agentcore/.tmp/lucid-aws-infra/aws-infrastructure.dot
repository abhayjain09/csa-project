digraph AWSInfrastructure {
  graph [
    rankdir=LR,
    bgcolor="white",
    pad="0.35",
    nodesep="0.5",
    ranksep="0.8",
    splines=ortho,
    fontname="Helvetica Neue"
  ];
  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#F7F8FA",
    color="#CBD1D8",
    penwidth=1.5,
    fontname="Helvetica Neue",
    fontsize=13,
    margin="0.20,0.14"
  ];
  edge [
    color="#5B6573",
    penwidth=1.6,
    arrowsize=0.75,
    fontname="Helvetica Neue",
    fontsize=10,
    fontcolor="#394150"
  ];

  subgraph cluster_aws {
    label="AWS Account — PageIndex AgentCore";
    color="#FF9900";
    penwidth=2;
    style="rounded";
    fontsize=15;
    fontname="Helvetica Neue";

    iam [label="AWS IAM\nShared execution role", fillcolor="#FDECEF", color="#DD344C"];
    ecr [label="Amazon ECR\nARM64 PageIndex image", fillcolor="#E8F1FB", color="#1F73B7"];
    lifecycle [label="ECR lifecycle policy\nKeep latest 5 images", fillcolor="#F5F7FA"];
    ec2 [label="Amazon EC2\nbuild_pdf_index.py", fillcolor="#FFF1E8", color="#ED7100"];
    agent [label="Bedrock AgentCore Runtime\nPageIndex container", fillcolor="#F1EAFE", color="#8C4FFF", penwidth=2.5];
    bedrock [label="Amazon Bedrock\nClaude inference profile", fillcolor="#F1EAFE", color="#8C4FFF"];
    s3 [label="Amazon S3\nPDFs + pageindex JSON", fillcolor="#EAF4E5", color="#3F8624"];
    logs [label="Amazon CloudWatch Logs\nRuntime logs", fillcolor="#EEF4E7", color="#759C3E"];

    { rank=same; iam; ecr; lifecycle; }
    { rank=same; ec2; agent; bedrock; }
    { rank=same; s3; logs; }

    lifecycle -> ecr [label="expires old images"];
    iam -> agent [label="execution role", color="#DD344C"];
    ecr -> agent [label="container image", color="#1F73B7"];
    ec2 -> agent [label="InvokeAgentRuntime", penwidth=2.3];
    ec2 -> s3 [label="list PDFs / index JSON", color="#3F8624"];
    agent -> s3 [label="GetObject PDF", color="#3F8624"];
    agent -> bedrock [label="InvokeModel", color="#8C4FFF", penwidth=2.3];
    agent -> logs [label="runtime logs", color="#759C3E"];
  }
}
