          "customData": [
            { "key": "ProvisionedBy", "value": "External" },
            { "key": "Access", "value": "ListBucket, GetObject, PutObject" }
          ],
          "zIndex": 3
        },
        {
          "id": "cloudwatch-logs",
          "type": "namedShape",
