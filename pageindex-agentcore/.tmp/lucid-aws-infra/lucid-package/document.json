          "customData": [
            { "key": "ProvisionedBy", "value": "External" },
            { "key": "Permission", "value": "bedrock:InvokeModel" }
          ],
          "zIndex": 3
        },
        {
          "id": "s3-reports",
          "type": "namedShape",
          "className": "ArchAmazonSimpleStorageServiceAWS2024",
          "boundingBox": { "x": 250, "y": 560, "w": 190, "h": 145 },
