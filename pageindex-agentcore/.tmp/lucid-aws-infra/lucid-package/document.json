          "className": "ArchAWSIdentityandAccessManagementAWS2024",
          "boundingBox": { "x": 250, "y": 120, "w": 170, "h": 130 },
          "text": "Shared IAM Role\nExecution + caller permissions",
          "note": "Terraform resource: aws_iam_role.pageindex",
